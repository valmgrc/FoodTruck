  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "SOPA DE MIJO:\n1. Muevete con W, A, S, D\n2. Click derecho a la primer
    estaci\xF3n con la tabal de cortar\n3. Click izquierdo selecciona el cuchillo\n4.
    Coloca el cuchillo sobre la cebolla y presiona espacio\n5. Repite lo mismo sobre
    el daikon\n6. Con click izquierdo coloca los vegetales en el bowl.\n7. Coloca
    el mijo en el bowl\n8. Cambia de estaci\xF3n con E\n9. Coloca el bow sobre la
    olla y con espacio tira los ingredientes hasta que el agua cambie de color.\n9.
    Suelta el bowl en la mesa.\n10. Coje el cucharon, espacio sobre la olla \n11.
    Con espacio sirve la sopa sobre el bowl\n12. TERMINASTE."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
